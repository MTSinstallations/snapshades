# SnapShades environment — local development template
# Copy to `.env` and fill in real values. Never commit `.env`.

# ── Supabase (required) ───────────────────────────────────────────────
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://ghqfpqthwgwogktlkfjp.supabase.co
VITE_SUPABASE_ANON_KEY=paste-anon-key-here
VITE_SITE_URL=https://snapshadesandshutters.com

# ── Stripe (required for checkout) ────────────────────────────────────
# Dashboard → Developers → API keys. Start with pk_test_... for dev.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── AI features (optional — degrade gracefully without them) ──────────
# These are SUPABASE SECRETS, not VITE_ env vars. Never expose to the browser.
# Set via: supabase secrets set ANTHROPIC_API_KEY=...
#
# ANTHROPIC_API_KEY=sk-ant-...    # Tape measure reader
# GOOGLE_AI_API_KEY=AIza...       # Room visualizer (optional)
# STRIPE_SECRET_KEY=sk_live_...   # Payment intent creation (server-side)
# STRIPE_WEBHOOK_SECRET=whsec_... # Payment confirmation webhook
# RESEND_API_KEY=re_...           # Paid-order and fulfillment email
# ORDER_FROM_EMAIL=SnapShades <hello@snapshadesandshutters.com>
# ORDER_REPLY_TO=hello@snapshadesandshutters.com
# ORDER_NOTIFICATION_EMAIL=hello@snapshadesandshutters.com
# ALLOWED_ORIGINS=https://snapshadesandshutters.com,https://www.snapshadesandshutters.com
# RATE_LIMIT_SALT=replace-with-a-long-random-secret
